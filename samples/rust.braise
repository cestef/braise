shell "bash"

recipe "test" {
    param coverage: bool = false

    if coverage {
        run "cargo tarpaulin --out html"
    } else {
        run "cargo nextest r"
    }
}


recipe "shell" {
    shell "bash -c"
    run "echo $0"
    shell "zsh -c"
    run "echo $0"
}

recipe "build" {
    param profile: ["debug", "release"] = if env.CI { "release" } else { "debug" }
    param jobs: int = if env.CI { cpu.count() } else { 1 }

    run "cargo build --profile ${profile} -j ${jobs}"
}

recipe "ci" -> ["lint", "test", "build"] {
    run "echo 'All checks passed!'"
}

recipe "lint" {
    run "cargo clippy -- -D warnings"
}

recipe "release" {
    if !git.is_clean() {
        run "echo 'Working directory must be clean'"
        exit 1
    }

    run "cargo release"
}