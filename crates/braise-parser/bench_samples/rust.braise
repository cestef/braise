recipe "test" {
    param coverage: bool = false

    if coverage {
        run "cargo tarpaulin --out html"
    } else {
        run "cargo nextest r"
    }
}

recipe "build" {
    param profile: ["debug", "release"] = if env.CI { "release" } else { "debug" }
    param jobs: number = if env.CI { cpu.count() } else { 1 }

    match profile {
        "debug" => print "Building in debug mode",
        "release" => print "Building in release mode",
        _ => print "Unknown profile: ${profile}",
    }

    let flag: string = match profile {
        "release" => "--release ",
        _ => "",
    }

    run "cargo build ${flag}-j ${jobs}"
}

recipe "ci" -> ["lint", "test"]{
    call @build(profile: "release", jobs: cpu.count())
}

recipe "lint" {
    run "cargo clippy -- -D warnings"
}

recipe "release" {
    if !git.is_clean() {
        run "echo 'Working directory must be clean'"
        exit 1
    }

    run "cargo release"
}