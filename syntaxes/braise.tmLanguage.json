{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Braisé",
    "scopeName": "source.braise",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#recipe-definition"
        },
        {
            "include": "#shell-statement"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#builtin-functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.braise",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.braise",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "comment.block.documentation.braise",
                            "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                }
            ]
        },
        "recipe-definition": {
            "patterns": [
                {
                    "name": "meta.recipe.braise",
                    "begin": "\\b(recipe)\\s+(\"[^\"]*\")",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "entity.name.function.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#recipe-dependencies"
                        },
                        {
                            "include": "#recipe-body"
                        }
                    ]
                }
            ]
        },
        "recipe-dependencies": {
            "patterns": [
                {
                    "name": "meta.recipe.dependencies.braise",
                    "begin": "->\\s*\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.operator.braise"
                        }
                    },
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "name": "punctuation.separator.braise",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "recipe-body": {
            "patterns": [
                {
                    "name": "meta.recipe.body.braise",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#statements"
                        }
                    ]
                }
            ]
        },
        "statements": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#param-statement"
                },
                {
                    "include": "#let-statement"
                },
                {
                    "include": "#if-statement"
                },
                {
                    "include": "#match-statement"
                },
                {
                    "include": "#for-statement"
                },
                {
                    "include": "#call-statement"
                },
                {
                    "include": "#run-statement"
                },
                {
                    "include": "#exit-statement"
                },
                {
                    "include": "#shell-statement"
                },
                {
                    "include": "#print-statement"
                },
                {
                    "include": "#try-catch-finally-statement"
                },
                {
                    "include": "#catch-block"
                },
                {
                    "include": "#finally-block"
                },
                {
                    "include": "#throw-statement"
                },
                {
                    "include": "#expressions"
                },
                {
                    "include": "#block"
                }
            ]
        },
        "throw-statement": {
            "patterns": [
                {
                    "name": "meta.throw.braise",
                    "begin": "\\b(throw)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "try-catch-finally-statement": {
            "patterns": [
                {
                    "name": "meta.try.braise",
                    "begin": "\\b(try)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?<=\\})(?!\\s*(?:catch|finally))",
                    "patterns": [
                        {
                            "include": "#block"
                        },
                        {
                            "include": "#catch-block"
                        },
                        {
                            "include": "#finally-block"
                        }
                    ]
                }
            ]
        },
        "catch-block": {
            "patterns": [
                {
                    "name": "meta.catch.braise",
                    "begin": "\\b(catch)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "variable.other.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "finally-block": {
            "patterns": [
                {
                    "name": "meta.finally.braise",
                    "begin": "\\b(finally)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "param-statement": {
            "patterns": [
                {
                    "name": "meta.param.braise",
                    "begin": "\\b(param)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "variable.parameter.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#type-annotations"
                        },
                        {
                            "name": "keyword.operator.assignment.braise",
                            "match": "="
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "type-annotations": {
            "patterns": [
                {
                    "name": "storage.type.primitive.braise",
                    "match": "\\b(string|number|int|bool)\\b"
                },
                {
                    "name": "storage.type.array.braise",
                    "begin": "\\[",
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#type-annotations"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "name": "punctuation.separator.type.braise",
                            "match": ","
                        }
                    ]
                },
                {
                    "name": "storage.type.union.braise",
                    "match": "\\|"
                }
            ]
        },
        "let-statement": {
            "patterns": [
                {
                    "name": "meta.let.braise",
                    "begin": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*:\\s*([^=]+?))?\\s*(=)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "variable.other.braise"
                        },
                        "3": {
                            "name": "storage.type.braise"
                        },
                        "4": {
                            "name": "keyword.operator.assignment.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#if-expression"
                        },
                        {
                            "include": "#match-expression"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "if-statement": {
            "patterns": [
                {
                    "name": "meta.if.braise",
                    "begin": "\\b(if)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.braise"
                        }
                    },
                    "end": "(?<=\\})(?!\\s*else)",
                    "patterns": [
                        {
                            "include": "#if-condition-and-block"
                        },
                        {
                            "include": "#else-if-chain"
                        },
                        {
                            "include": "#else-block"
                        }
                    ]
                }
            ]
        },
        "if-condition-and-block": {
            "patterns": [
                {
                    "name": "meta.if.condition.braise",
                    "begin": "(?<=if)\\s+",
                    "end": "(?=\\{)",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                },
                {
                    "include": "#block"
                }
            ]
        },
        "else-if-chain": {
            "patterns": [
                {
                    "name": "meta.else-if.braise",
                    "begin": "\\b(else)\\s+(if)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.braise"
                        },
                        "2": {
                            "name": "keyword.control.conditional.braise"
                        }
                    },
                    "end": "(?<=\\})(?!\\s*else)",
                    "patterns": [
                        {
                            "name": "meta.else-if.condition.braise",
                            "begin": "(?<=if)\\s+",
                            "end": "(?=\\{)",
                            "patterns": [
                                {
                                    "include": "#expressions"
                                }
                            ]
                        },
                        {
                            "include": "#block"
                        },
                        {
                            "include": "#else-if-chain"
                        },
                        {
                            "include": "#else-block"
                        }
                    ]
                }
            ]
        },
        "else-block": {
            "patterns": [
                {
                    "name": "meta.else.braise",
                    "begin": "\\b(else)\\b(?!\\s+if)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "if-expression": {
            "patterns": [
                {
                    "name": "meta.if.expression.braise",
                    "begin": "\\b(if)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.braise"
                        }
                    },
                    "end": "(?<=\\})(?!\\s*else)",
                    "patterns": [
                        {
                            "include": "#if-condition-and-block"
                        },
                        {
                            "include": "#else-if-chain"
                        },
                        {
                            "include": "#else-block"
                        }
                    ]
                }
            ]
        },
        "match-expression": {
            "patterns": [
                {
                    "name": "meta.match.expression.braise",
                    "begin": "\\b(match)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#match-arms"
                        }
                    ]
                }
            ]
        },
        "match-statement": {
            "patterns": [
                {
                    "name": "meta.match.braise",
                    "begin": "\\b(match)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#match-arms"
                        }
                    ]
                }
            ]
        },
        "match-arms": {
            "patterns": [
                {
                    "name": "meta.match.arm.braise",
                    "begin": "(\"[^\"]*\"|\\d+(?:\\.\\d+)?|true|false|_|\\[.*?\\]|\\d+\\.\\.=?\\d*|\\d*\\.\\.)\\s*(if\\s+[^=>]*)?\\s*(=>)",
                    "beginCaptures": {
                        "1": {
                            "name": "constant.other.braise"
                        },
                        "2": {
                            "name": "keyword.control.conditional.braise"
                        },
                        "3": {
                            "name": "keyword.operator.braise"
                        }
                    },
                    "end": "(?=\\s*(?:\"[^\"]*\"|\\d+(?:\\.\\d+)?|true|false|_|\\[.*?\\]|\\d+\\.\\.=?\\d*|\\d*\\.\\.)\\s*(?:if\\s+[^=>]*)?\\s*=>|\\s*\\})",
                    "patterns": [
                        {
                            "include": "#statements"
                        },
                        {
                            "include": "#block"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                },
                {
                    "name": "meta.match.arm.variable.braise",
                    "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(if\\s+[^=>]*)?\\s*(=>)",
                    "beginCaptures": {
                        "1": {
                            "name": "variable.other.braise"
                        },
                        "2": {
                            "name": "keyword.control.conditional.braise"
                        },
                        "3": {
                            "name": "keyword.operator.braise"
                        }
                    },
                    "end": "(?=\\s*(?:[a-zA-Z_][a-zA-Z0-9_]*|\"[^\"]*\"|\\d+(?:\\.\\d+)?|true|false|_|\\[.*?\\]|\\d+\\.\\.=?\\d*|\\d*\\.\\.)\\s*(?:if\\s+[^=>]*)?\\s*=>|\\s*\\})",
                    "patterns": [
                        {
                            "include": "#statements"
                        },
                        {
                            "include": "#block"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                },
                {
                    "include": "#comments"
                }
            ]
        },
        "for-statement": {
            "patterns": [
                {
                    "name": "meta.for.braise",
                    "begin": "\\b(for)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.loop.braise"
                        },
                        "2": {
                            "name": "variable.other.braise"
                        },
                        "3": {
                            "name": "keyword.control.loop.braise"
                        }
                    },
                    "end": "(?<=\\})\\s*(async)?",
                    "endCaptures": {
                        "1": {
                            "name": "keyword.control.async.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "call-statement": {
            "patterns": [
                {
                    "name": "meta.call.braise",
                    "begin": "\\b(call)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.call.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#call-target"
                        },
                        {
                            "include": "#call-arguments"
                        }
                    ]
                }
            ]
        },
        "call-target": {
            "patterns": [
                {
                    "name": "meta.call.target.recipe-reference.braise",
                    "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.recipe-reference.braise"
                        },
                        "2": {
                            "name": "entity.name.function.recipe.braise"
                        }
                    }
                },
                {
                    "name": "meta.call.target.variable.braise",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\(|\\s*$)",
                    "captures": {
                        "1": {
                            "name": "variable.other.recipe.braise"
                        }
                    }
                }
            ]
        },
        "call-arguments": {
            "patterns": [
                {
                    "name": "meta.call.arguments.braise",
                    "begin": "\\(",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.begin.braise"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#call-named-parameters"
                        }
                    ]
                }
            ]
        },
        "call-named-parameters": {
            "patterns": [
                {
                    "name": "meta.parameter.named.call.braise",
                    "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.name.braise"
                        },
                        "2": {
                            "name": "punctuation.separator.parameter.braise"
                        }
                    }
                },
                {
                    "include": "#expressions"
                },
                {
                    "name": "punctuation.separator.parameter.braise",
                    "match": ","
                }
            ]
        },
        "run-statement": {
            "patterns": [
                {
                    "name": "meta.run.braise",
                    "begin": "\\b(run)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "exit-statement": {
            "patterns": [
                {
                    "name": "meta.exit.braise",
                    "begin": "\\b(exit)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "shell-statement": {
            "patterns": [
                {
                    "name": "meta.shell.braise",
                    "begin": "\\b(shell)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "print-statement": {
            "patterns": [
                {
                    "name": "meta.print.braise",
                    "begin": "\\b(print)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?=\\n\\s*(?:[a-zA-Z]|\\})|\\}|$)",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "block": {
            "patterns": [
                {
                    "name": "meta.block.braise",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#statements"
                        }
                    ]
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#recipe-reference"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#arrays"
                },
                {
                    "include": "#ranges"
                },
                {
                    "include": "#function-calls"
                },
                {
                    "include": "#builtin-functions"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#identifiers"
                }
            ]
        },
        "arrays": {
            "patterns": [
                {
                    "name": "meta.array.braise",
                    "begin": "\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.begin.braise"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "name": "punctuation.separator.array.braise",
                            "match": ","
                        },
                        {
                            "name": "keyword.operator.spread.braise",
                            "match": "\\.\\."
                        }
                    ]
                }
            ]
        },
        "ranges": {
            "patterns": [
                {
                    "name": "meta.range.inclusive.braise",
                    "match": "(\\d+)\\s*(\\.\\.)=\\s*(\\d+)",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.braise"
                        },
                        "2": {
                            "name": "keyword.operator.range.braise"
                        },
                        "3": {
                            "name": "constant.numeric.braise"
                        }
                    }
                },
                {
                    "name": "meta.range.exclusive.braise",
                    "match": "(\\d+)?\\s*(\\.\\.)\\s*(\\d+)?",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.braise"
                        },
                        "2": {
                            "name": "keyword.operator.range.braise"
                        },
                        "3": {
                            "name": "constant.numeric.braise"
                        }
                    }
                }
            ]
        },
        "function-calls": {
            "patterns": [
                {
                    "name": "meta.function.call.braise",
                    "begin": "([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)(\\()",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.braise"
                        },
                        "2": {
                            "name": "punctuation.definition.parameters.begin.braise"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "name": "punctuation.separator.parameter.braise",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.braise",
                    "match": "\\b(recipe|param|let|if|else|match|for|in|call|run|exit|async|print|try|catch|finally|throw|shell)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.braise",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.braise",
                            "match": "\\\\."
                        },
                        {
                            "include": "#string-interpolation"
                        }
                    ]
                }
            ]
        },
        "string-interpolation": {
            "patterns": [
                {
                    "name": "meta.embedded.expression.braise",
                    "begin": "\\$\\{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.begin.braise"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.braise",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.braise",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.braise",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.braise",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.braise",
                    "match": "="
                },
                {
                    "name": "keyword.operator.range.braise",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.braise",
                    "match": "->|=>|@"
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.braise",
                    "match": "\\b(env|cpu|git|fs|input)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.braise",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "recipe-reference": {
            "patterns": [
                {
                    "name": "meta.recipe.reference.braise",
                    "begin": "(@)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.recipe-reference.braise"
                        },
                        "2": {
                            "name": "entity.name.function.recipe.braise"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.braise"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#recipe-parameters"
                        }
                    ]
                },
                {
                    "name": "meta.recipe.reference.simple.braise",
                    "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.recipe-reference.braise"
                        },
                        "2": {
                            "name": "entity.name.function.recipe.braise"
                        }
                    }
                }
            ]
        },
        "recipe-parameters": {
            "patterns": [
                {
                    "name": "meta.parameter.named.braise",
                    "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.braise"
                        },
                        "2": {
                            "name": "punctuation.separator.parameter.braise"
                        }
                    }
                },
                {
                    "include": "#expressions"
                },
                {
                    "name": "punctuation.separator.parameter.braise",
                    "match": ","
                }
            ]
        }
    }
}