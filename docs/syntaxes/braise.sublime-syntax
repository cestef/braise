%YAML 1.2
---
# Braise Language Syntax for Sublime Text
# Based on the TextMate grammar for Braise
name: Braise
file_extensions:
  - braise
  - Braisefile
scope: source.braise

contexts:
  main:
    - include: comments
    - include: recipe-definition
    - include: shell-statement
    - include: keywords
    - include: strings
    - include: numbers
    - include: operators
    - include: builtin-functions

  comments:
    # Line comments starting with //
    - match: //.*$
      scope: comment.line.double-slash.braise
    # Block comments /* ... */
    - match: /\*
      scope: punctuation.definition.comment.begin.braise
      push:
        - meta_scope: comment.block.braise
        - match: \*/
          scope: punctuation.definition.comment.end.braise
          pop: true
        - match: '@[a-zA-Z_][a-zA-Z0-9_]*'
          scope: comment.block.documentation.braise

  recipe-definition:
    # Recipe definition: recipe "name" -> ["deps"] { ... }
    - match: \b(recipe)\s+("([^"]*)") 
      captures:
        1: keyword.control.braise
        2: entity.name.function.braise
        3: string.quoted.double.braise
      push:
        - meta_scope: meta.recipe.braise
        - include: recipe-dependencies
        - include: recipe-body
        - match: (?<=\})
          pop: true

  recipe-dependencies:
    # Dependencies: -> ["dep1", "dep2"]
    - match: '->\s*\['
      scope: keyword.operator.braise
      push:
        - meta_scope: meta.recipe.dependencies.braise
        - match: '\]'
          pop: true
        - include: strings

  recipe-body:
    # Recipe body block
    - match: '\{'
      scope: punctuation.definition.block.begin.braise
      push:
        - meta_scope: meta.recipe.body.braise
        - match: '\}'
          scope: punctuation.definition.block.end.braise
          pop: true
        - include: statements

  statements:
    - include: comments
    - include: param-statement
    - include: let-statement
    - include: if-statement
    - include: match-statement
    - include: for-statement
    - include: call-statement
    - include: run-statement
    - include: exit-statement
    - include: shell-statement
    - include: print-statement
    - include: expressions

  param-statement:
    # Parameter definition: param name: type = default
    - match: \b(param)\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*:\s*([a-zA-Z0-9_\[\]"\,\s\|]+)
      captures:
        1: keyword.control.braise
        2: variable.parameter.braise
        3: storage.type.braise

  let-statement:
    # Variable declaration: let name: type = value
    - match: \b(let)\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\s*:\s*([a-zA-Z0-9_\[\]"\,\s\|]+))?\s*(=)
      captures:
        1: keyword.control.braise
        2: variable.other.braise
        3: storage.type.braise
        4: keyword.operator.assignment.braise
      push:
        - meta_scope: meta.let.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: if-expression
        - include: match-expression
        - include: expressions

  if-statement:
    # If statement: if condition { ... } else { ... }
    - match: \b(if)\b
      scope: keyword.control.conditional.braise
      push:
        - meta_scope: meta.if.braise
        - match: (?<=\})(?!\s*else)
          pop: true
        - include: if-condition-and-block
        - include: else-if-chain
        - include: else-block

  if-condition-and-block:
    - match: (?<=if)\s+
      push:
        - meta_scope: meta.if.condition.braise
        - match: (?=\{)
          pop: true
        - include: expressions
    - include: block

  else-if-chain:
    - match: \b(else)\s+(if)\b
      captures:
        1: keyword.control.conditional.braise
        2: keyword.control.conditional.braise
      push:
        - meta_scope: meta.else-if.braise
        - match: (?<=\})(?!\s*else)
          pop: true
        - match: (?<=if)\s+
          push:
            - meta_scope: meta.else-if.condition.braise
            - match: (?=\{)
              pop: true
            - include: expressions
        - include: block
        - include: else-if-chain
        - include: else-block

  else-block:
    - match: \b(else)\b(?!\s+if)
      scope: keyword.control.conditional.braise
      push:
        - meta_scope: meta.else.braise
        - match: (?<=\})
          pop: true
        - include: block

  if-expression:
    # If expression (for use in assignments)
    - match: \b(if)\b
      scope: keyword.control.conditional.braise
      push:
        - meta_scope: meta.if.expression.braise
        - match: (?<=\})(?!\s*else)
          pop: true
        - include: if-condition-and-block
        - include: else-if-chain
        - include: else-block

  match-statement:
    # Match statement: match expr { pattern => ... }
    - match: \b(match)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.match.braise
        - match: (?<=\})
          pop: true
        - include: expressions
        - include: match-arms

  match-expression:
    # Match expression (for use in assignments)
    - match: \b(match)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.match.expression.braise
        - match: (?<=\})
          pop: true
        - include: expressions
        - include: match-arms

  match-arms:
    # Match arms: pattern => expression
    - match: ("([^"]*)"|_|\b[a-zA-Z_][a-zA-Z0-9_]*\b|\d+(?:\.\d+)?|\b(?:true|false)\b)\s*(=>)
      captures:
        1: constant.other.braise
        3: keyword.operator.braise
      push:
        - meta_scope: meta.match.arm.braise
        - match: (?=\s*(?:"[^"]*"|_|\b[a-zA-Z_][a-zA-Z0-9_]*\b|\d+(?:\.\d+)?|\b(?:true|false)\b)\s*=>|\s*\})
          pop: true
        - include: statements
        - include: block
    - include: comments

  for-statement:
    # For loop: for var in iterable { ... } async
    - match: \b(for)\s+([a-zA-Z_][a-zA-Z0-9_]*)\s+(in)\b
      captures:
        1: keyword.control.loop.braise
        2: variable.other.braise
        3: keyword.control.loop.braise
      push:
        - meta_scope: meta.for.braise
        - match: (?<=\})\s*(async)?
          captures:
            1: keyword.control.async.braise
          pop: true
        - include: expressions
        - include: block

  call-statement:
    # Call statement: call @recipe_name or call recipe_var
    - match: \b(call)\b
      scope: keyword.control.call.braise
      push:
        - meta_scope: meta.call.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: call-target
        - include: call-arguments

  call-target:
    # Recipe reference: @recipe_name
    - match: (@)([a-zA-Z_][a-zA-Z0-9_]*)
      captures:
        1: keyword.operator.recipe-reference.braise
        2: entity.name.function.recipe.braise
    # Variable reference
    - match: \b([a-zA-Z_][a-zA-Z0-9_]*)(?=\s*\(|\s*$)
      captures:
        1: variable.other.recipe.braise

  call-arguments:
    # Function call arguments: (param1: value1, param2: value2)
    - match: \(
      scope: punctuation.definition.parameters.begin.braise
      push:
        - meta_scope: meta.call.arguments.braise
        - match: \)
          scope: punctuation.definition.parameters.end.braise
          pop: true
        - include: call-named-parameters

  call-named-parameters:
    # Named parameter: name: value
    - match: ([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)
      captures:
        1: variable.parameter.name.braise
        2: punctuation.separator.parameter.braise
    - include: expressions
    - match: ','
      scope: punctuation.separator.parameter.braise

  run-statement:
    # Run statement: run "command"
    - match: \b(run)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.run.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: strings
        - include: expressions

  exit-statement:
    # Exit statement: exit 1
    - match: \b(exit)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.exit.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: expressions

  shell-statement:
    # Shell statement: shell "bash"
    - match: \b(shell)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.shell.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: expressions

  print-statement:
    # Print statement: print "message"
    - match: \b(print)\b
      scope: keyword.control.braise
      push:
        - meta_scope: meta.print.braise
        - match: (?=\n\s*(?:[a-zA-Z]|\})|$|\})
          pop: true
        - include: expressions

  block:
    # Generic block: { ... }
    - match: '\{'
      scope: punctuation.definition.block.begin.braise
      push:
        - meta_scope: meta.block.braise
        - match: '\}'
          scope: punctuation.definition.block.end.braise
          pop: true
        - include: statements

  expressions:
    - include: recipe-reference
    - include: strings
    - include: numbers
    - include: booleans
    - include: builtin-functions
    - include: operators
    - include: identifiers

  keywords:
    # Language keywords
    - match: \b(recipe|param|let|if|else|match|for|in|call|run|exit|async|print|shell)\b
      scope: keyword.control.braise

  strings:
    # Double-quoted strings with interpolation
    - match: '"'
      scope: punctuation.definition.string.begin.braise
      push:
        - meta_scope: string.quoted.double.braise
        - match: '"'
          scope: punctuation.definition.string.end.braise
          pop: true
        - match: '\\.'
          scope: constant.character.escape.braise
        - include: string-interpolation

  string-interpolation:
    # String interpolation: ${expression}
    - match: '\$\{'
      scope: punctuation.definition.template-expression.begin.braise
      push:
        - meta_scope: meta.embedded.expression.braise
        - match: '\}'
          scope: punctuation.definition.template-expression.end.braise
          pop: true
        - include: expressions

  numbers:
    # Numeric literals
    - match: '\b\d+(?:\.\d+)?\b'
      scope: constant.numeric.braise

  booleans:
    # Boolean literals
    - match: \b(true|false)\b
      scope: constant.language.boolean.braise

  operators:
    # Comparison operators
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.braise
    # Logical operators
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.braise
    # Assignment operator
    - match: '='
      scope: keyword.operator.assignment.braise
    # Special operators
    - match: '->|=>|@'
      scope: keyword.operator.braise

  builtin-functions:
    # Built-in module names
    - match: \b(env|cpu|git|fs|input|os)\b
      scope: support.function.builtin.braise

  identifiers:
    # Generic identifiers
    - match: \b[a-zA-Z_][a-zA-Z0-9_]*\b
      scope: variable.other.braise

  recipe-reference:
    # Recipe reference with parameters: @recipe(param: value)
    - match: (@)([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()
      captures:
        1: keyword.operator.recipe-reference.braise
        2: entity.name.function.recipe.braise
        3: punctuation.definition.parameters.begin.braise
      push:
        - meta_scope: meta.recipe.reference.braise
        - match: \)
          scope: punctuation.definition.parameters.end.braise
          pop: true
        - include: recipe-parameters
    # Simple recipe reference: @recipe
    - match: (@)([a-zA-Z_][a-zA-Z0-9_]*)
      captures:
        1: keyword.operator.recipe-reference.braise
        2: entity.name.function.recipe.braise

  recipe-parameters:
    # Named parameter in recipe reference
    - match: ([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)
      captures:
        1: variable.parameter.braise
        2: punctuation.separator.parameter.braise
    - include: expressions
    - match: ','
      scope: punctuation.separator.parameter.braise