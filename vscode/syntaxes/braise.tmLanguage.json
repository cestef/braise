{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Braisé",
    "scopeName": "source.braise",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#recipe-definition"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#builtin-functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.braise",
                    "match": "//.*$"
                }
            ]
        },
        "recipe-definition": {
            "patterns": [
                {
                    "name": "meta.recipe.braise",
                    "begin": "\\b(recipe)\\s+(\"[^\"]*\")",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "entity.name.function.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#recipe-dependencies"
                        },
                        {
                            "include": "#recipe-body"
                        }
                    ]
                }
            ]
        },
        "recipe-dependencies": {
            "patterns": [
                {
                    "name": "meta.recipe.dependencies.braise",
                    "begin": "->\\s*\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.operator.braise"
                        }
                    },
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#strings"
                        }
                    ]
                }
            ]
        },
        "recipe-body": {
            "patterns": [
                {
                    "name": "meta.recipe.body.braise",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#statements"
                        }
                    ]
                }
            ]
        },
        "statements": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#param-statement"
                },
                {
                    "include": "#if-statement"
                },
                {
                    "include": "#match-statement"
                },
                {
                    "include": "#for-statement"
                },
                {
                    "include": "#run-statement"
                },
                {
                    "include": "#exit-statement"
                },
                {
                    "include": "#print-statement"
                },
                {
                    "include": "#expressions"
                }
            ]
        },
        "param-statement": {
            "patterns": [
                {
                    "name": "meta.param.braise",
                    "match": "\\b(param)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([a-zA-Z0-9_\\[\\]\"\\,\\s]+)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.braise"
                        },
                        "2": {
                            "name": "variable.parameter.braise"
                        },
                        "3": {
                            "name": "storage.type.braise"
                        }
                    }
                }
            ]
        },
        "if-statement": {
            "patterns": [
                {
                    "name": "meta.if.braise",
                    "begin": "\\b(if)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "match-statement": {
            "patterns": [
                {
                    "name": "meta.match.braise",
                    "begin": "\\b(match)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "(?<=\\})",
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#match-arms"
                        }
                    ]
                }
            ]
        },
        "match-arms": {
            "patterns": [
                {
                    "name": "meta.match.arm.braise",
                    "match": "(\"[^\"]*\"|_)\\s*(=>)",
                    "captures": {
                        "1": {
                            "name": "constant.other.braise"
                        },
                        "2": {
                            "name": "keyword.operator.braise"
                        }
                    }
                }
            ]
        },
        "for-statement": {
            "patterns": [
                {
                    "name": "meta.for.braise",
                    "begin": "\\b(for)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.loop.braise"
                        },
                        "2": {
                            "name": "variable.other.braise"
                        },
                        "3": {
                            "name": "keyword.control.loop.braise"
                        }
                    },
                    "end": "(?<=\\})\\s*(async)?",
                    "endCaptures": {
                        "1": {
                            "name": "keyword.control.async.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        },
                        {
                            "include": "#block"
                        }
                    ]
                }
            ]
        },
        "run-statement": {
            "patterns": [
                {
                    "name": "meta.run.braise",
                    "begin": "\\b(run)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "exit-statement": {
            "patterns": [
                {
                    "name": "meta.exit.braise",
                    "begin": "\\b(exit)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "print-statement": {
            "patterns": [
                {
                    "name": "meta.print.braise",
                    "begin": "\\b(print)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.braise"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "block": {
            "patterns": [
                {
                    "name": "meta.block.braise",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#statements"
                        }
                    ]
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#builtin-functions"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#identifiers"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.braise",
                    "match": "\\b(recipe|param|if|else|match|for|in|run|exit|async|print)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.braise",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.braise",
                            "match": "\\\\."
                        },
                        {
                            "include": "#string-interpolation"
                        }
                    ]
                }
            ]
        },
        "string-interpolation": {
            "patterns": [
                {
                    "name": "meta.embedded.expression.braise",
                    "begin": "\\$\\{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.begin.braise"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.end.braise"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.braise",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.braise",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.braise",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.braise",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.braise",
                    "match": "="
                },
                {
                    "name": "keyword.operator.braise",
                    "match": "->|=>"
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.braise",
                    "match": "\\b(env|cpu|git|fs)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.braise",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}