{
    "name": "braise-language-support",
    "displayName": "Braisé Language Support",
    "description": "Language support for Braisé's DSL",
    "version": "0.1.0",
    "publisher": "cstef",
    "repository": "https://github.com/cestef/braise",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "braise",
        "recipe"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:braise"
    ],
    "contributes": {
        "languages": [
            {
                "id": "braise",
                "aliases": [
                    "Braisé",
                    "braisé",
                    "Braise"
                ],
                "extensions": [
                    ".braise",
                    ".braisefile"
                ],
                "filenames": [
                    "Braisefile"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/icon.svg",
                    "dark": "./assets/icon.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "braise",
                "scopeName": "source.braise",
                "path": "../syntaxes/braise.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Braise Language Server",
            "properties": {
                "braise.enableLSP": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable the Braise Language Server."
                }
            }
        },
        "commands": [
            {
                "command": "braise.restartLSP",
                "title": "Restart Language Server",
                "category": "Braise"
            }
        ]
    },
    "scripts": {
        "compile": "npm run check-types && node esbuild.js",
        "check-types": "tsc --noEmit",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "vscode:prepublish": "npm run package",
        "package": "npm run check-types && node esbuild.js --production"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.6",
        "@types/node": "~24.0.10",
        "@types/vscode": "^1.101.0",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.25.5",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "files": [
        "out",
        "../syntaxes/braise.tmLanguage.json",
        "assets",
        "language-configuration.json",
        "package.json",
        "LICENSE"
    ]
}