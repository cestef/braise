{
    "name": "braise-language-support",
    "displayName": "Braisé Language Support",
    "description": "Language support for Braisé's DSL",
    "version": "0.1.0",
    "publisher": "cstef",
    "repository": "https://github.com/cestef/braise",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "braise",
        "recipe"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:braise"
    ],
    "contributes": {
        "languages": [
            {
                "id": "braise",
                "aliases": [
                    "Braise",
                    "braise"
                ],
                "extensions": [
                    ".braise"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/icon.svg",
                    "dark": "./assets/icon.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "braise",
                "scopeName": "source.braise",
                "path": "./syntaxes/braise.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Braise Language Server",
            "properties": {
                "braise.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "braise.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language server."
                },
                "braise.enableLSP": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable the Braise Language Server."
                }
            }
        },
        "commands": [
            {
                "command": "braise.runRecipe",
                "title": "Run Recipe",
                "category": "Braise"
            }
        ],
        "snippets": [
            {
                "language": "braise",
                "path": "./snippets.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.6",
        "@types/node": "~24.0.10",
        "@types/vscode": "^1.101.0",
        "@vscode/vsce": "^3.6.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}