recipe "hello" {
    param name: string = "World"
    print "Hello, ${name}!"
}

recipe "build" -> ["test"] {
    run "cargo build --release"
}

recipe "test" {
    run "cargo test"
}

recipe "deploy" {
    param env: ["dev", "prod"] = "dev"
    param version: string
    param force: bool = false
    param replicas: number = 3
    param services: [string] = []

    print "Deploying version ${version} to ${env} environment with ${replicas} replicas."
    if force {
        print "Force deployment enabled."
    }

    for service in services {
        print "Deploying service: ${service}"
    }

}

recipe "smart-build" {
    match env.get("CI") {
        "true" => run "cargo build --release",
        _ => run "cargo build"
    }
}

recipe "infinite" {
    call @infinite
}

recipe "r1" {
    call @r2
}

recipe "r2" {
    call @r3
}

recipe "r3" {
    call @r1
}
