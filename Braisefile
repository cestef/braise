recipe "hello" {
    param name: string = "World"
    print "Hello, ${name}!"
}

recipe "build" -> ["test"] {
    run "cargo build --release"
}

recipe "test" {
    run "cargo test"
}

recipe "deploy" {
    param env: ["dev", "prod"] = "dev"
    param version: string
    param force: bool = false
    param replicas: number = 3
    param services: [string] = []

    print "Deploying version ${version} to ${env} environment with ${replicas} replicas."
    if force {
        print "Force deployment enabled."
    }

    for service in services {
        print "Deploying service: ${service}"
    }

}

recipe "smart-build" {
    match env.get("CI") {
        s if s == "true" => run "cargo build --release",
        _ => run "cargo build"
    }
}

recipe "infinite" {
    call @infinite
}

recipe "r1" {
    call @r2
}

recipe "r2" {
    call @r3
}

recipe "r3" {
    call @r1
}

recipe "cleanup_test" {
    try {
        run "echo 'Doing work'"
        throw "Something went wrong"
    } catch e {
        print "Caught an error: ${e}"
    } finally {
        run "echo 'Cleaning up'"
    }
}

recipe "calculate" {
    let a: string = "5"
    let b: string = "10"
    let sum = a + b
    print "The sum of ${a} and ${b} is ${sum}."
}

recipe "check-number" {
    param num: number = 10
    if num > 0 {
        print "${num} is positive."
    } else if num < 0 {
        print "${num} is negative."
    } else {
        print "${num} is zero."
    }
}

recipe "print-numbers" {
    param numbers: [number] = [1, 2, 3, 4, 5]
    for num in numbers {
        print "Number: ${num}"
    } async
}

recipe "match-example" {
    param value: string = "apple"
    match value {
        "apple" => {
            print "It's an apple!"
        },
        e => {
            print "It's something else: ${e}"
        }
    }
}

recipe "match-array" {
    param items: [string] = ["apple", "banana", "cherry"]
    match items {
        ["apple", ..rest] => {
            print "The first item is an apple and the rest are: ${rest}"
        },
        e => {
            print "The items are: ${e}"
        }
    }
}

recipe "match-range" {
    param value: number = 5
    match value {
        1..10 => {
            print "${value} is between 1 and 10."
        },
        11..20 => {
            print "${value} is between 11 and 20."
        },
        _ => {
            print "${value} is outside the range."
        }
    }
}